{
  "name": "agentic-everything",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.9.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.json && node scripts/link-build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node scripts/test.mjs",
    "lint": "node scripts/lint.mjs",
    "dev": "tsc -p tsconfig.json --watch",
    "schemas": "npm run build && node dist/packages/contracts/src/export-schemas.js",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@dbos-inc/dbos-sdk": "5.3.0",
    "@hono/node-server": "2.1.5",
    "@modelcontextprotocol/server": "2.4.0",
    "@openai/agents": "0.21.0",
    "@radix-ui/react-tabs": "1.2.1",
    "hono": "4.13.13",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.3",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
